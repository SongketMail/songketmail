[Unit]
Description=SongketMail IMAP Service Container
After=network-online.target

[Container]
ContainerName={{ cluster_prefix }}_imap
Image=docker.io/library/dovecot:latest
Pod={{ cluster_prefix }}_pod.pod
Volume={{ storage_base_path }}/imap/{{ inventory_hostname }}/data:/var/lib/dovecot:Z
Environment=TZ=UTC
Label=fabric_cluster={{ cluster_prefix }}
Label=service_type=imap

[Install]
WantedBy=default.target
