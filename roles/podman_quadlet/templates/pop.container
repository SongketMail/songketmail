[Unit]
Description=SongketMail POP3 Service Container
After=network-online.target

[Container]
ContainerName={{ cluster_prefix }}_pop
Image=docker.io/library/dovecot:latest
Pod={{ cluster_prefix }}_pod.pod
Volume={{ storage_base_path }}/pop/{{ inventory_hostname }}/data:/var/lib/dovecot-pop3:Z
Environment=TZ=UTC
Label=fabric_cluster={{ cluster_prefix }}
Label=service_type=pop

[Install]
WantedBy=default.target
