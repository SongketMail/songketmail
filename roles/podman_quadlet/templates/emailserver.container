[Container]
ContainerName={{ cluster_prefix }}_emailserver
Image=docker.io/library/postfix:{{ postfix_image_tag }}
Pod={{ cluster_prefix }}_pod.pod
Volume={{ storage_base_path }}/emailserver/{{ inventory_hostname }}/data:/var/mail:Z
Environment=TZ=UTC
Environment=MY_UID={{ songketmail_uid }}
Environment=MY_GID={{ songketmail_gid }}
Exec=/usr/sbin/postfix start-fg
