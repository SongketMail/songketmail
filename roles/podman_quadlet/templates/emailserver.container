[Unit]
Description=SongketMail Email Server Service Container
After=network-online.target

[Container]
ContainerName={{ cluster_prefix }}_emailserver
Image=docker.io/library/postfix:latest
Pod={{ cluster_prefix }}_pod.pod
Volume={{ storage_base_path }}/emailserver/{{ inventory_hostname }}/data:/var/mail:Z
Environment=TZ=UTC
Environment=MY_UID={{ songketmail_uid }}
Environment=MY_GID={{ songketmail_gid }}
Exec=/usr/sbin/postfix start-fg
Label=fabric_cluster={{ cluster_prefix }}
Label=service_type=emailserver

[Install]
# Active service integration within systemd user session
WantedBy=default.target
