[Unit]
Description=SongketMail Webmail Client Container
After=network-online.target

[Container]
ContainerName={{ cluster_prefix }}_webmail
Image=docker.io/library/roundcube:latest
Pod={{ cluster_prefix }}_pod.pod
Volume={{ storage_base_path }}/webmail/{{ inventory_hostname }}/data:/var/www/html:Z
Environment=TZ=UTC
Label=fabric_cluster={{ cluster_prefix }}
Label=service_type=webmail

[Install]
WantedBy=default.target
