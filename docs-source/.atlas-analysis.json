  "keyFeatures": [
    "Rootless Podman 5+ Quadlet orchestration with native systemd integration",
    "Seven-service containerized email fabric: proxy, MTA, MDA, spam filter, webmail, database, object storage",
    "Storage Sovereignty via keep-id UID/GID 2001 namespace mapping",
    "BunkerWeb WAF as hardened SSL ingress with PROXY protocol client IP preservation",
    "Postfix MTA + Dovecot MDA with PostgreSQL virtual mailbox accounts",
    "RustFS S3-compatible object storage for mail bodies and attachments",
    "Rspamd spam and policy filtering via milter integration",
    "Roundcube webmail with persistent PostgreSQL-backed sessions",
    "Fabric isolation via cluster-prefixed pod and network namespacing",
    "ASIMP OS hardening pipeline (Lynis + OpenSCAP + Debsums)",
    "Ansible FQCN-compliant, fully declarative deployment automation",
    "Ansible-driven symmetric privilege strategy separating rootful tuning from rootless containers"
  ],
  "publicApiSurface": [
    "ansible-playbook -i inventory/hosts.ini site.yml",
    "systemctl --user status songketmail_pod-pod.service",
    "systemctl --user start|stop|restart songketmail_<service>.service",
    "group_vars/all.yml — cluster_prefix, storage_base_path, image tags",
    "inventory/hosts.ini — target node definitions",
    "roles/podman_quadlet/templates/ — Quadlet .container, .pod, .network files",
    "roles/host_prepare/tasks/main.yml — host preparation tasks",
    "roles/host_prepare/tasks/audit.yml — ASIMP security audit tasks",
    "loginctl enable-linger songket",
    "XDG_RUNTIME_DIR=/run/user/2001",
    "DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/2001/bus",
    "UserNS=keep-id:uid=2001,gid=2001 (Quadlet pod-level namespace)"
  ]
}
